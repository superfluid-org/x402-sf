
FACILITATOR_PRIVATE_KEY=your_private_key_here

# Network selection. Leave unset / "false" for Base mainnet; "true" for Base Sepolia.
TESTNET_MODE=false

# RPC endpoint. Mainnet (clear signing): https://rpc-endpoints.superfluid.dev/base-mainnet
# Testnet: https://rpc-endpoints.superfluid.dev/base-sepolia
BASE_RPC_URL=https://rpc-endpoints.superfluid.dev/base-mainnet

# Deployed SuperfluidFacilitator contract. When set, payments are processed via a single
# atomic contract call instead of multiple EOA transactions.
# Set the mainnet clear-signing facilitator contract address here for launch.
FACILITATOR_CONTRACT_ADDRESS=

# Clear Macro relay (POST /clearmacro/relay). The provider string whose AccessControl role
# the facilitator must hold on the ClearMacroForwarder — Superfluid grants
# keccak256(CLEARMACRO_PROVIDER) to this facilitator's address.
CLEARMACRO_PROVIDER=x402.superfluid.eth
# Optional allowlist: when set, only this macro (CreateFlowMacro deployment) is relayed.
CREATE_FLOW_MACRO_ADDRESS=

PORT=4020
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173
